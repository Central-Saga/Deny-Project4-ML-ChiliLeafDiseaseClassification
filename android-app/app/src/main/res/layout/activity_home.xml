<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- BRANDING: LOGO ASLI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:id="@+id/imgAppLogo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/logo_chilileaf"
                    android:scaleType="fitCenter"
                    android:background="#E1EFE3"
                    android:padding="4dp"
                    android:contentDescription="Logo ChiliLeaf AI"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ChiliLeaf AI"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#214A32"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asisten Kesehatan Tanaman Cabai"
                        android:textSize="12sp"
                        android:textColor="#789080"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BANNER BERANDA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E0EEE1"
                android:padding="22dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SELAMAT DATANG"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4B8460"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rawat Cabai,\nPanen Lebih Baik."
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#204B34"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kenali kondisi daun cabai menggunakan Machine Learning offline."
                    android:textSize="14sp"
                    android:textColor="#63816B"
                    android:layout_marginTop="12dp"/>
                <Button
                    android:id="@+id/btnGoDetect"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:text="Mulai Deteksi Sekarang"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2B704B"/>
            </LinearLayout>

            <!-- SHORTCUT MENU -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jelajahi Fitur"
                android:textStyle="bold"
                android:textSize="21sp"
                android:textColor="#243E2C"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/btnGoHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp"
                android:contentDescription="Buka Riwayat Deteksi">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#EDF5EB"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#2B704B"
                    android:contentDescription="Riwayat"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Riwayat Deteksi" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#294C35"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lihat hasil scan sebelumnya" android:textSize="12sp"
                        android:textColor="#809185" android:layout_marginTop="3dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp" android:textColor="#55836A"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGoGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp"
                android:contentDescription="Buka Panduan Penyakit">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#EDF5EB"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#2B704B"
                    android:contentDescription="Panduan"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Panduan Penyakit" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#294C35"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Gejala dan langkah penanganan" android:textSize="12sp"
                        android:textColor="#809185" android:layout_marginTop="3dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp" android:textColor="#55836A"/>
            </LinearLayout>

            <!-- EMPAT GAMBAR KONDISI -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Kenali Kondisi Daun" android:textSize="20sp"
                android:textStyle="bold" android:textColor="#243E2C"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Empat kelas yang dikenali oleh model AI" android:textSize="13sp"
                android:textColor="#809084" android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#FFFFFF" android:padding="8dp"
                    android:elevation="2dp" android:layout_marginEnd="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="135dp"
                        android:src="@drawable/guide_fresh_leaf" android:scaleType="fitCenter"
                        android:contentDescription="Ilustrasi Fresh Leaf"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Fresh Leaf" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="#294F36" android:gravity="center" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#FFFFFF" android:padding="8dp"
                    android:elevation="2dp" android:layout_marginStart="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="135dp"
                        android:src="@drawable/guide_leaf_curl" android:scaleType="fitCenter"
                        android:contentDescription="Ilustrasi Leaf Curl Disease"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Leaf Curl Disease" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="#294F36" android:gravity="center" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#FFFFFF" android:padding="8dp"
                    android:elevation="2dp" android:layout_marginEnd="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="135dp"
                        android:src="@drawable/guide_cercospora" android:scaleType="fitCenter"
                        android:contentDescription="Ilustrasi Cercospora"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Cercospora Leaf Spot" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="#294F36" android:gravity="center" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#FFFFFF" android:padding="8dp"
                    android:elevation="2dp" android:layout_marginStart="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="135dp"
                        android:src="@drawable/guide_anthracnose" android:scaleType="fitCenter"
                        android:contentDescription="Ilustrasi Anthracnose"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Anthracnose" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="#294F36" android:gravity="center" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gambar ilustrasi AI untuk edukasi, bukan foto diagnostik terverifikasi."
                android:textSize="11sp" android:textColor="#87968A"
                android:gravity="center" android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view" app:tint="#2B704B"
                android:contentDescription="Beranda"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Beranda" android:textStyle="bold" android:textSize="11sp"
                android:textColor="#2B704B" android:layout_marginTop="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navDetect"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_camera" app:tint="#87968B"
                android:contentDescription="Deteksi"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Deteksi" android:textSize="11sp"
                android:textColor="#87968B" android:layout_marginTop="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_recent_history" app:tint="#87968B"
                android:contentDescription="Riwayat"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Riwayat" android:textSize="11sp"
                android:textColor="#87968B" android:layout_marginTop="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navGuide"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_info_details" app:tint="#87968B"
                android:contentDescription="Panduan"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Panduan" android:textSize="11sp"
                android:textColor="#87968B" android:layout_marginTop="5dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
