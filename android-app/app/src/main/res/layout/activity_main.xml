<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chili Leaf Disease Detection"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#235B39"
            android:gravity="center"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deteksi kondisi daun cabai menggunakan Machine Learning"
            android:textSize="14sp"
            android:textColor="#66756A"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"/>

        <ImageView
            android:id="@+id/imgLeafPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#E4EDE4"
            android:contentDescription="Preview gambar daun cabai"
            android:scaleType="fitCenter"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Gambar dari Galeri"
            android:textAllCaps="false"
            android:layout_marginTop="22dp"/>

        <ProgressBar
            android:id="@+id/progressPrediction"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Silakan pilih gambar daun cabai."
            android:textSize="14sp"
            android:textColor="#66756A"
            android:gravity="center"
            android:layout_marginTop="18dp"/>

        <TextView
            android:id="@+id/txtPredictionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textColor="#235B39"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>