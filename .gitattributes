# Auto detect text files and perform LF normalization
* text=auto

# Gradle wrapper scripts must keep exact line endings across platforms
gradlew text eol=lf
**/gradlew text eol=lf
*.sh text eol=lf
gradlew.bat text eol=crlf
**/gradlew.bat text eol=crlf
*.bat text eol=crlf

# Source and configuration files
.gitignore text eol=lf
**/.gitignore text eol=lf
.gitattributes text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.pro text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Binary assets and model files
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.tflite binary
*.keras binary
*.h5 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
